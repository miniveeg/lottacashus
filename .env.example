# ──────────────────────────────────────────────────────────────────────────────
# LottaCash — Frontend Environment Variables (Vite / Vercel)
# Copy to .env and fill in. NEVER commit .env.
# Full production guide: DEPLOY.md
# ──────────────────────────────────────────────────────────────────────────────

# Supabase project (required for auth, wallet, bets, realtime).
# Vercel → Project → Settings → Environment Variables (Production + Preview)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Discord OAuth (Settings → link Discord). Optional.
VITE_DISCORD_CLIENT_ID=your-discord-application-client-id

# ──────────────────────────────────────────────────────────────────────────────
# Supabase Edge Function secrets (Dashboard → Edge Functions → Secrets)
# or: npx supabase secrets set KEY=value
# Do NOT put these in Vite / Vercel — they are server-side only.
# ──────────────────────────────────────────────────────────────────────────────
#
# REQUIRED for production CORS:
#   ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
#
# REQUIRED for auth email codes:
#   SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS, SMTP_FROM
#
# REQUIRED for crypto deposits/withdrawals:
#   CRYPTO_MASTER_MNEMONIC
#   MAIN_SOL_WALLET, MAIN_LTC_WALLET, MAIN_ETH_WALLET
#
# REQUIRED for cron endpoints (poll-deposits, sweep-deposits, crash-settle-expired):
#   CRON_SECRET
#
# OPTIONAL for Discord OAuth (edge):
#   DISCORD_CLIENT_ID, DISCORD_CLIENT_SECRET
#
# OPTIONAL for chain scanning:
#   BLOCKCYPHER_TOKEN, ETHERSCAN_API_KEY
