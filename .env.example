# ──────────────────────────────────────────────────────────────────────────────
# LottaCash — Environment Variables
# Copy to .env and fill in. NEVER commit .env.
# ──────────────────────────────────────────────────────────────────────────────

# Supabase project (required for auth, wallet, bets, realtime).
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Discord OAuth (Settings → link Discord).
VITE_DISCORD_CLIENT_ID=your-discord-application-client-id

# ──────────────────────────────────────────────────────────────────────────────
# Supabase Edge Function secrets (set in Supabase → Edge Functions → Secrets)
# Do NOT add these to .env — they are server-side only.
# ──────────────────────────────────────────────────────────────────────────────
#
# REQUIRED for auth flows:
#   SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS, SMTP_FROM
#
# REQUIRED for crypto deposits/withdrawals:
#   CRYPTO_MASTER_MNEMONIC
#   MAIN_SOL_WALLET, MAIN_LTC_WALLET, MAIN_ETH_WALLET
#
# REQUIRED for cron endpoints:
#   CRON_SECRET
#
# REQUIRED for production CORS lockdown:
#   ALLOWED_ORIGINS=https://lottacash.com,https://www.lottacash.com
#
# OPTIONAL for Discord OAuth:
#   DISCORD_CLIENT_ID, DISCORD_CLIENT_SECRET
#
# OPTIONAL for chain scanning:
#   BLOCKCYPHER_TOKEN, ETHERSCAN_API_KEY
