# Copy to .env for local dev. Add the same keys in Vercel → Settings → Environment Variables.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Discord OAuth (Settings → link Discord). Redirect URI must be https://your-domain/settings
VITE_DISCORD_CLIENT_ID=your-discord-application-client-id

# Local only — do NOT add to Vercel (the website itself does not need these).
# They are required by the manual sweep scripts in /scripts.
# CRON_SECRET=same-as-supabase-secrets-and-cron-job-org
# Used by: npm run sweep:remote

# ──────────────────────────────────────────────────────────────────────────────
# Supabase Edge Function secrets (set in Supabase → Edge Functions → Secrets)
# ──────────────────────────────────────────────────────────────────────────────
#
# REQUIRED for auth flows:
#   SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS, SMTP_FROM
#     — Used by send-signup-code / send-password-reset-code to deliver emails.
#
# REQUIRED for crypto deposits/withdrawals:
#   CRYPTO_MASTER_MNEMONIC
#     — BIP39 mnemonic used to derive deposit addresses and sign withdrawals.
#   MAIN_SOL_WALLET, MAIN_LTC_WALLET, MAIN_ETH_WALLET
#     — Treasury wallet addresses that receive swept deposits. NO defaults are
#       baked in — deposits will fail loudly if these are missing.
#
# REQUIRED for cron endpoints (sweep-deposits, poll-deposits):
#   CRON_SECRET
#     — Shared secret passed via the `x-cron-secret` header. The endpoint will
#       reject requests if this is unset or mismatched.
#
# RECOMMENDED for production CORS lockdown:
#   ALLOWED_ORIGINS=https://lottacash.com,https://www.lottacash.com
#     — Comma-separated list of allowed frontend origins. When unset, CORS is
#       open to any origin (`*`), which is fine for local dev but should be
#       locked down in production.
#
# OPTIONAL for Discord OAuth:
#   DISCORD_CLIENT_ID, DISCORD_CLIENT_SECRET
#     — Discord application credentials. Required for the link-discord flow.
