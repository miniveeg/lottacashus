# Copy to .env for local dev. Add the same keys in Vercel → Settings → Environment Variables.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Discord OAuth (Settings → link Discord). Redirect URI must be https://your-domain/settings
VITE_DISCORD_CLIENT_ID=your-discord-application-client-id

# Local only — do NOT add to Vercel (website does not need these)
# CRON_SECRET=same-as-supabase-secrets-and-cron-job-org
# Used by: npm run sweep:remote
