# Copy to scripts/sweep.env (gitignored) and fill in real values.
# NEVER commit sweep.env — it contains your mnemonic and service role key.

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

CRYPTO_MASTER_MNEMONIC=word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12

MAIN_SOL_WALLET=617G2ByNoHDu75oSNVqiwbho5Z3iHpGytTswufiiV42o
MAIN_LTC_WALLET=LTtJVrXcdDPFf9yrNkqJpuyY2aPuiNppn1
MAIN_ETH_WALLET=0x6e1641a2D94F3f3605De0f62AECf677B996006A0

# Required for LTC sweep
BLOCKCYPHER_TOKEN=your_blockcypher_token

# Optional
ETH_RPC_URL=https://ethereum.publicnode.com
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional: comma-separated one-off targets (same format as SWEEP_EXTRA in edge config)
# SWEEP_EXTRA=LTC_abc123...64hexprivatekey
